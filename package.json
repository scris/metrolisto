{
  "name": "metrolisto",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "pnpm format:city:check && tsc -b && vite build",
    "build:android": "pnpm build && pnpm sync:capacitor",
    "build:ios": "pnpm build && pnpm sync:capacitor",
    "build:harmony": "pnpm build && pnpm sync:harmony",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "format": "pnpm format:city && prettier --write src scripts docs .github *.json *.ts *.yaml *.md index.html",
    "format:check": "pnpm format:city:check && prettier --check src scripts docs .github *.json *.ts *.yaml *.md index.html",
    "format:city": "node scripts/format-city-data.mjs --write",
    "format:city:check": "node scripts/format-city-data.mjs --check",
    "copy:capacitor": "npx cap copy",
    "sync:capacitor": "npx cap sync",
    "sync:harmony": "node scripts/sync-harmony.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "^8.0.2",
    "@fontsource/manrope": "^5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tdesign-mobile-react": "^0.23.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.6.2",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wrangler": "^4.146.0"
  }
}
